# WhatsApp Automation Local Configuration
ENVIRONMENT=development
PORT=8002
HOST=0.0.0.0
DEBUG=true

MOCK_MODE=true

DEFAULT_CAFE_ID=cafe_central_001
DEFAULT_CAFE_NAME="The Roasted Bean Cafe"

DATABASE_URL=sqlite:///./whatsapp_automation.db

WHATSAPP_PHONE_NUMBER_ID=mock_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=mock_business_account_id
WHATSAPP_ACCESS_TOKEN=mock_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=cafe_whatsapp_webhook_secret_token

CAFE_API_BASE_URL=http://localhost:4000/api
CAFE_API_KEY=mock_cafe_api_key

MARKETING_HOURLY_RATE_LIMIT=100
MAX_RETRIES_PER_MESSAGE=3
BOOKING_REMINDER_FIRST_HOURS=24
BOOKING_REMINDER_SECOND_HOURS=2

API_KEY_SECRET=cafe_automation_secret_key_change_in_prod
WEBHOOK_SECRET=cafe_webhook_secret_key
