# ==============================================================================
# WhatsApp Automation Service Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Mock Mode Configuration
# When MOCK_MODE=true, no real WhatsApp messages or external API calls are made.
# Everything is simulated locally.
MOCK_MODE=true

# Default Cafe ID
DEFAULT_CAFE_ID=cafe_central_001
DEFAULT_CAFE_NAME="The Roasted Bean Cafe"

# Database Configuration (SQLite by default, compatible with PostgreSQL/Supabase)
DATABASE_URL=sqlite:///./whatsapp_automation.db

# WhatsApp Business Cloud API Configuration (for production when MOCK_MODE=false)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=cafe_whatsapp_webhook_secret_token

# Cafe API Integration (Cafe Admin Dashboard Webhook / API URL)
CAFE_API_BASE_URL=http://localhost:3000/api
CAFE_API_KEY=

# Automation & Safeguard Settings
MARKETING_HOURLY_RATE_LIMIT=100
MAX_RETRIES_PER_MESSAGE=3
BOOKING_REMINDER_FIRST_HOURS=24
BOOKING_REMINDER_SECOND_HOURS=2

# Security & Authentication
API_KEY_SECRET=cafe_automation_secret_key_change_in_prod
WEBHOOK_SECRET=cafe_webhook_secret_key
