# ==================================================
# AI CALLING SYSTEM ENVIRONMENT CONFIGURATION
# ==================================================

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Mock Mode Configuration
# When set to true, the system runs with local simulation (no external API keys required)
MOCK_MODE=true

# Security Configuration
API_KEY=dev-secret-key-change-in-production
ENABLE_API_AUTH=false
RATE_LIMIT_PER_MINUTE=60

# Provider Selection (options: mock | openai | twilio | elevenlabs | whisper)
PROVIDER_TELEPHONY=mock
PROVIDER_STT=mock
PROVIDER_TTS=mock
PROVIDER_LLM=mock

# Database Configuration
DATABASE_URL=sqlite:///./ai_calling.db

# Cafe Configuration & API Integration
CAFE_ID=cafe-bella-vista
CAFE_API_BASE_URL=http://localhost:5000/api
USE_MOCK_CAFE_API=true

# Telephony Provider (Twilio) Settings (Required only if PROVIDER_TELEPHONY=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OpenAI Provider Settings (Required if PROVIDER_LLM=openai, PROVIDER_STT=whisper, or PROVIDER_TTS=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_VOICE=alloy

# ElevenLabs Provider Settings (Required if PROVIDER_TTS=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Human Escalation Settings
HUMAN_AGENT_PHONE=+15551234567
ESCALATION_EMAIL=manager@bellavista.cafe
MAX_MISUNDERSTANDINGS_BEFORE_ESCALATION=3
